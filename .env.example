# ─── Database (Neon Postgres via Vercel Marketplace) ───
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (required in production) ───
AUTH_SECRET="run-openssl-rand-base64-32"
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── OAuth (optional) ───
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Maps (configure only providers you use) ───
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Site / SEO ───
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ─── Analytics (optional — Plausible is cookieless; leave blank / noop to disable) ───
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_PROVIDER="noop"

# ─── Storage (required in practice — photo upload fails without it) ───
BLOB_READ_WRITE_TOKEN=""

# ─── Rate limiting (STRONGLY recommended in production) ───
# Without these, every rate limit — including the fail-closed ones on login,
# password reset and share creation — falls back to a per-instance in-memory
# Map that resets on each cold start. On Vercel that is effectively no rate
# limiting at all. Create a free Upstash Redis database and paste both values.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Transactional email (password reset) ───
RESEND_API_KEY=""
EMAIL_FROM="HiddenSpots <noreply@your-domain.com>"

# ─── Web Push (optional) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Cron (required for scheduled Drive backup — Vercel Cron Authorization bearer) ───
CRON_SECRET="run-openssl-rand-base64-32"

# ─── Error triage (optional — Slack/Discord incoming webhook for /api/client-error) ───
ERROR_WEBHOOK_URL=""

# ─── E2E tests (optional — specs needing a session self-skip without these) ───
TEST_EMAIL=""
TEST_PASSWORD=""
TEST_PUBLIC_SHARE_TOKEN=""
TEST_SECRET_SHARE_TOKEN=""
TEST_PRIVATE_NOTE_SNIPPET=""

# ─── Vercel Production Checklist ───
# 1. Set all env vars above in Vercel Dashboard → Settings → Environment Variables
# 2. Link Neon Postgres integration (auto-fills DATABASE_URL + DIRECT_URL)
# 3. First deploy after schema-via-db-push: mark baseline applied:
#      npx prisma migrate resolve --applied 0_init
#      npx prisma migrate resolve --applied 20260723010944_add_drive_backup
#      npx prisma migrate deploy
# 4. Deploy: vercel --prod  (uses build:deploy from vercel.json)
# 5. Health check: GET /api/health
# 6. Region: fra1 (Frankfurt — closest to Israel)
# 7. Cron: CRON_SECRET must match; schedule hits /api/cron/drive-backup daily 03:00 UTC
