# ─── Database (Neon Postgres via Vercel Marketplace) ───
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (required in production) ───
AUTH_SECRET="run-openssl-rand-base64-32"
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── OAuth (optional) ───
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Maps (configure only providers you use) ───
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Site / SEO ───
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ─── Analytics (optional — Plausible is cookieless; leave blank / noop to disable) ───
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_PROVIDER="noop"

# ─── Storage ───
BLOB_READ_WRITE_TOKEN=""

# ─── Web Push (optional) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Cron (required for scheduled Drive backup — Vercel Cron Authorization bearer) ───
CRON_SECRET="run-openssl-rand-base64-32"

# ─── Error triage (optional — Slack/Discord incoming webhook for /api/client-error) ───
ERROR_WEBHOOK_URL=""

# ─── i18n ───
NEXT_PUBLIC_DEFAULT_LOCALE=he

# ─── Vercel Production Checklist ───
# 1. Set all env vars above in Vercel Dashboard → Settings → Environment Variables
# 2. Link Neon Postgres integration (auto-fills DATABASE_URL + DIRECT_URL)
# 3. First deploy after schema-via-db-push: mark baseline applied:
#      npx prisma migrate resolve --applied 0_init
#      npx prisma migrate resolve --applied 20260723010944_add_drive_backup
#      npx prisma migrate deploy
# 4. Deploy: vercel --prod  (uses build:deploy from vercel.json)
# 5. Health check: GET /api/health
# 6. Region: fra1 (Frankfurt — closest to Israel)
# 7. Cron: CRON_SECRET must match; schedule hits /api/cron/drive-backup daily 03:00 UTC
