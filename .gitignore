# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything is ignored except the committed template
.env*
!.env.example

# local embedded postgres
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo

# generated service worker — next.config.ts `swDest` rewrites this on every build
/public/sw.js
/public/sw.js.map

# machine-local agent settings (launch.json is shared, settings.local.json is not)
.claude/settings.local.json
